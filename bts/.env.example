# Valamm AI integration: every environment variable it uses, with the real non-secret values from this repository.
# Secrets are left empty; see SECRETS_REQUIRED.md for how to get them. Values marked (cloud) come from
# infra/terraform/01_DEV/cloud_run_services/terraform.tfvars; everything else is the local development setup.

# =====================================================================================================================
# 1. AI GATEWAY  (services/ai/api/.env, prefix AI_; app/config.py)
# =====================================================================================================================
AI_API_PORT=8005
# local | production   (cloud: production)
AI_ENVIRONMENT=local
# mock | groq | anthropic | bedrock | vertex | gemini.  Gemini on Vertex AI is the one in use.
AI_PROVIDER=gemini
# Local default model.  (cloud DEV: gemini-3.1-pro-preview; UAT and PROD: gemini-2.5-flash)
AI_DEFAULT_MODEL=gemini-2.5-flash
# Google Cloud project that runs Vertex AI.  (cloud: project://id, i.e. this project in DEV)
AI_VERTEX_PROJECT=project-8ce5ae3e-81f4-4585-b74
# Local: asia-south1.  (cloud DEV, UAT, PROD: global)
AI_VERTEX_LOCATION=asia-south1
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.4
# Claude on Vertex (AI_PROVIDER=vertex only; not in use)
AI_VERTEX_MODEL=claude-3-5-sonnet-v2@20241022

# Other providers (not used with AI_PROVIDER=gemini). Keys are empty in this repository.
AI_ANTHROPIC_API_KEY=
AI_GROQ_API_KEY=
AI_GROQ_MODEL=llama-3.3-70b-versatile
AI_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_AWS_REGION=us-east-1
AI_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# Google credentials: none here. The Gemini provider uses Application Default Credentials:
#   local  -> gcloud auth application-default login
#   cloud  -> the Cloud Run service account (roles/aiplatform.user)
# Do NOT set GOOGLE_API_KEY; the code does not use an API key.

# =====================================================================================================================
# 2. CALLING SERVICE  (settings ISV Onboarding uses: services/isv-onboarding/api/.env; app/config.py)
# =====================================================================================================================
# Local gateway.  (cloud: service://ai-gateway, resolved by Terraform to the gateway's Cloud Run URL)
AI_GATEWAY_URL=http://localhost:8005
# Blank = the gateway's default model.  (cloud DEV: gemini-4-argon; UAT and PROD: gemini-2.5-pro)
CHAT_AI_MODEL=
CHAT_AI_ENABLED=true
# Seconds.  (cloud DEV: 90.0; UAT and PROD: 60.0)
CHAT_AI_TIMEOUT=30.0
# Local .env value is 320; code default and cloud: 4096
CHAT_AI_MAX_TOKENS=4096
CHAT_AI_SUMMARY_MAX_TOKENS=300
CHAT_AI_TEMPERATURE=0.35
# Document reading (code defaults; cloud: CHAT_AI_DOC_MAX_TOKENS=8192, DEV CHAT_AI_DOC_MODEL=gemini-3.1-pro-preview)
CHAT_AI_DOC_MODEL=
CHAT_AI_DOC_TIMEOUT=180.0
CHAT_AI_DOC_MAX_TOKENS=32768
CHAT_AI_CLASSIFY_MAX_TOKENS=8192
CHAT_RECOMMEND_MODEL=
CHAT_MIN_CONFIDENCE=0.70

# =====================================================================================================================
# 3. SERVICE-TO-SERVICE AUTH  (packages/core/valamm_core/auth.py; same on the gateway and on every caller)
# =====================================================================================================================
# off = local development, every request allowed.  (cloud: identity_platform)
AUTH_MODE=off
# Shared secret for X-Valamm-Internal. Empty locally. (cloud: from Secret Manager; see SECRETS_REQUIRED.md)
INTERNAL_TOKEN=
# Comma-separated base URLs that get the X-Valamm-Internal header. (cloud: internal-urls://, every service's URL)
INTERNAL_URLS=
