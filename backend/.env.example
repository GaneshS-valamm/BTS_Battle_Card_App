# Copy to backend/.env for local development. Never commit the real .env.

# Database. Leave empty locally to use SQLite (backend/abhay.db).
# Locally use the Render database's external URL; on Render use its internal URL.
DATABASE_URL=

# AI: Gemini on Vertex AI.
# Option A: a Vertex AI API key ("AQ...."). Used first when set; no gcloud login needed.
AI_VERTEX_API_KEY=
# Option B: project + Application Default Credentials (gcloud auth application-default login).
# Leave both empty to run without AI (features show "not set up yet").
AI_PROVIDER=gemini
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_VERTEX_PROJECT=
AI_VERTEX_LOCATION=asia-south1
AI_TEMPERATURE=0.4
# Live Google Search grounding for company checks, photo identification and reports (true/false)
LLM_WEB_SEARCH=true

# Per-IP cap on AI calls (company check, suggestions, reports, photo reads) per hour
AI_RATE_LIMIT_PER_HOUR=40

# Optional shared access key. When set, every /api call needs header X-Abhay-Key.
APP_ACCESS_KEY=

# Comma-separated origins allowed to call the API (only needed when the frontend
# is served from a different origin, e.g. the Vite dev server).
CORS_ORIGINS=http://localhost:5173
